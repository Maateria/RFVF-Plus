@ The stage NPCs turn back to the stage after talking.
LilycoveCity_ContestHall_EventScript_FaceOriginalDirection::
	closemessage
	applymovement VAR_LAST_TALKED, Common_Movement_FaceOriginalDirection
	waitmovement 0
	release
	end

