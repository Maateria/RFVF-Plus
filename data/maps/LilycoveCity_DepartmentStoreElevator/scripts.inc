LilycoveCity_DepartmentStoreElevator_MapScripts::
	.byte 0

@ Emerald's attendant on the Celadon Dept Store elevator code path (floor window, menu, shake, dynamic warp).
@ VAR_ELEVATOR_FLOOR: 4 = 1F ... 8 = 5F, like Celadon.
LilycoveCity_DepartmentStoreElevator_EventScript_Attendant::
	goto_if_questlog EventScript_ReleaseEnd
	lock
	faceplayer
	call_if_unset FLAG_TEMP_2, EventScript_GetElevatorFloor
	copyvar VAR_0x8005, VAR_ELEVATOR_FLOOR
	special DrawElevatorCurrentFloorWindow
	message gText_WhichFloorWouldYouLike
	waitmessage
	specialvar VAR_RESULT, InitElevatorFloorSelectMenuPos
	switch VAR_RESULT
	case 0, LilycoveCity_DepartmentStoreElevator_EventScript_FloorSelectFrom5F
	case 1, LilycoveCity_DepartmentStoreElevator_EventScript_FloorSelectFrom4F
	case 2, LilycoveCity_DepartmentStoreElevator_EventScript_FloorSelectFrom3F
	case 3, LilycoveCity_DepartmentStoreElevator_EventScript_FloorSelectFrom2F
	case 4, LilycoveCity_DepartmentStoreElevator_EventScript_FloorSelectFrom1F
	end

@ The cursor starts on the current floor
LilycoveCity_DepartmentStoreElevator_EventScript_FloorSelectFrom5F::
	multichoicedefault 0, 0, MULTICHOICE_DEPT_STORE_ELEVATOR, 0, FALSE
	goto LilycoveCity_DepartmentStoreElevator_EventScript_ChooseFloor
	end

LilycoveCity_DepartmentStoreElevator_EventScript_FloorSelectFrom4F::
	multichoicedefault 0, 0, MULTICHOICE_DEPT_STORE_ELEVATOR, 1, FALSE
	goto LilycoveCity_DepartmentStoreElevator_EventScript_ChooseFloor
	end

LilycoveCity_DepartmentStoreElevator_EventScript_FloorSelectFrom3F::
	multichoicedefault 0, 0, MULTICHOICE_DEPT_STORE_ELEVATOR, 2, FALSE
	goto LilycoveCity_DepartmentStoreElevator_EventScript_ChooseFloor
	end

LilycoveCity_DepartmentStoreElevator_EventScript_FloorSelectFrom2F::
	multichoicedefault 0, 0, MULTICHOICE_DEPT_STORE_ELEVATOR, 3, FALSE
	goto LilycoveCity_DepartmentStoreElevator_EventScript_ChooseFloor
	end

LilycoveCity_DepartmentStoreElevator_EventScript_FloorSelectFrom1F::
	multichoicedefault 0, 0, MULTICHOICE_DEPT_STORE_ELEVATOR, 4, FALSE
	goto LilycoveCity_DepartmentStoreElevator_EventScript_ChooseFloor
	end

LilycoveCity_DepartmentStoreElevator_EventScript_ChooseFloor::
	switch VAR_RESULT
	case 0, LilycoveCity_DepartmentStoreElevator_EventScript_To5F
	case 1, LilycoveCity_DepartmentStoreElevator_EventScript_To4F
	case 2, LilycoveCity_DepartmentStoreElevator_EventScript_To3F
	case 3, LilycoveCity_DepartmentStoreElevator_EventScript_To2F
	case 4, LilycoveCity_DepartmentStoreElevator_EventScript_To1F
	case 5, LilycoveCity_DepartmentStoreElevator_EventScript_ExitFloorSelect
	case SCR_MENU_CANCEL, LilycoveCity_DepartmentStoreElevator_EventScript_ExitFloorSelect
	end

LilycoveCity_DepartmentStoreElevator_EventScript_To1F::
	setvar VAR_0x8006, 4
	setdynamicwarp MAP_LILYCOVE_CITY_DEPARTMENT_STORE_1F, 2, 1
	goto_if_eq VAR_ELEVATOR_FLOOR, 4, LilycoveCity_DepartmentStoreElevator_EventScript_ExitFloorSelect
	call LilycoveCity_DepartmentStoreElevator_EventScript_MoveElevator
	setvar VAR_ELEVATOR_FLOOR, 4
	goto LilycoveCity_DepartmentStoreElevator_EventScript_ExitFloorSelect
	end

