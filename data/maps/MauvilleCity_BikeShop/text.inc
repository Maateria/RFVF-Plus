@ pokeemerald data/maps/MauvilleCity_BikeShop/scripts.inc, official French text (tools/hoenn_import/hoenn_texts.py)
MauvilleCity_BikeShop_Text_RydelGreeting::
    .string "Bon, bon, bon… Qu'est-ce qu'on a là?\n"
    .string "Un client des plus énergiques!\p"
    .string "Moi? Tu peux m'appeler RODOLPHE.\n"
    .string "Je suis le propriétaire de ce\l"
    .string "magasin de vélos.$"

@ RFVF+
MauvilleCity_BikeShop_Text_LetMeUpgradeYourBike::
    .string "RODOLPHE: Oh! Mais c'est une\n"
    .string "BICYCLETTE de KANTO que tu as là!\p"
    .string "Pas mal… Mais elle ne vaut pas\n"
    .string "mes VELOS!\p"
    .string "Je vais te la régler aux petits\n"
    .string "oignons: elle aura l'accélération\l"
    .string "du VELO COURSE et les sauts\l"
    .string "du VELO CROSS!\p"
    .string "Comme ça, plus besoin de choisir!\n"
    .string "Prête-la-moi une seconde…$"

MauvilleCity_BikeShop_Text_HandedOverBike::
    .string "{PLAYER} confie sa BICYCLETTE\n"
    .string "à RODOLPHE.\p"
    .string "… … … … … …\n"
    .string "… … … … … …$"

MauvilleCity_BikeShop_Text_BikeUpgraded::
    .string "La BICYCLETTE de {PLAYER}\n"
    .string "a été améliorée!$"

MauvilleCity_BikeShop_Text_HowToRide::
    .string "RODOLPHE: Maintiens la touche B en\n"
    .string "roulant pour accélérer comme avec\l"
    .string "un VELO COURSE.\p"
    .string "Lancé à pleine vitesse, tu grimpes\n"
    .string "les pentes boueuses et tu passes\l"
    .string "sur les sols fragiles!\p"
    .string "Maintiens B sans bouger pour lever\n"
    .string "la roue avant et sauter sur place.\l"
    .string "Avance pour sauter en avançant.\p"
    .string "Relâche B pour reposer ta roue.\p"
    .string "Et appuie sur B en même temps\n"
    .string "qu'une direction pour sauter sur\l"
    .string "le côté ou faire demi-tour!$"

MauvilleCity_BikeShop_Text_HowsYourBike::
    .string "RODOLPHE: Alors, ta BICYCLETTE?\n"
    .string "Elle file comme le vent, hein?$"

MauvilleCity_BikeShop_Text_NoBikeWhereYouComeFrom::
    .string "RODOLPHE: Tes CHAUSSURES DE SPORT…\n"
    .string "Elles sont dégoûtantes!\p"
    .string "Tu as fait toute la route à pied?\p"
    .string "Ha ha ha! Il n'y a donc pas de\n"
    .string "vélos, là d'où tu viens?\p"
    .string "Reviens me voir avec un vélo, je te\n"
    .string "montrerai ce qu'il a dans le ventre!$"

@ pokeemerald data/maps/MauvilleCity_BikeShop/scripts.inc, official French text (tools/hoenn_import/hoenn_texts.py)
MauvilleCity_BikeShop_Text_HandbooksAreInBack::
    .string "J'apprends beaucoup de\n"
    .string "choses sur les VELOS depuis\l"
    .string "que je travaille ici.\p"
    .string "Si tu as besoin de conseils pour\n"
    .string "conduire ton vélo, il y a deux ou\l"
    .string "trois manuels derrière.$"

@ RFVF+: the handbooks of the upgraded Bicycle (Emerald's describe its two bikes)
MauvilleCity_BikeShop_Text_MachHandbook::
    .string "C'est un guide sur la vitesse\n"
    .string "du VELO COURSE.\p"
    .string "Maintenez le bouton B en roulant:\n"
    .string "le vélo accélère jusqu'à\l"
    .string "sa vitesse de pointe.\p"
    .string "A pleine vitesse, il est possible\n"
    .string "de gravir un versant de sable\l"
    .string "et de passer sur un sol fragile\l"
    .string "sans tomber à l'étage du dessous.$"

MauvilleCity_BikeShop_Text_AcroHandbook::
    .string "C'est un guide sur les sauts\n"
    .string "du VELO CROSS.\p"
    .string "A l'arrêt, maintenez le bouton B:\n"
    .string "la roue avant se soulève, puis\l"
    .string "le vélo saute sur place.\p"
    .string "Utilisez la manette + pour avancer\n"
    .string "en sautant, par-dessus les bosses.\l"
    .string "Relâchez B pour vous arrêter.\p"
    .string "Appuyez sur B en même temps qu'une\n"
    .string "direction pour un saut latéral,\l"
    .string "ou pour faire demi-tour.\p"
    .string "Les rails se prennent dans\n"
    .string "leur sens: sautez dessus\l"
    .string "de côté pour y monter.$"
