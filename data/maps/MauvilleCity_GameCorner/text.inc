MauvilleCity_GameCorner_Text_GotTwoOfSameMonWantOne::
    .string "Je me suis trompée. J'ai gagné\n"
    .string "deux fois les mêmes POKéMON.\p"
    .string "Tu en veux un?$"

MauvilleCity_GameCorner_Text_WhichOneDoYouWant::
    .string "Lequel veux-tu?$"

MauvilleCity_GameCorner_Text_YouWantOneButNotNow::
    .string "Hein?\n"
    .string "Tu le veux, mais pas tout de suite?$"

MauvilleCity_GameCorner_Text_DontBeNegativeTakeOne::
    .string "Oh, ne t'en fais pas!\n"
    .string "Tu sais, tu peux le prendre.$"
